# ── Copy this into: Streamlit Cloud → App Settings → Secrets ─────────────────
# No password needed — the app is open access with quota limits.

# ── Primary AI provider (Groq free tier — no CC needed) ──────────────────────
AI_PROVIDER = "groq"
GROQ_API_KEY = "gsk_your_key_here"
GROQ_MODEL   = "llama-3.3-70b-versatile"

# ── Chat tab (Gemini free tier) ───────────────────────────────────────────────
GEMINI_API_KEY = "AIza_your_gemini_key_here"

# ── Optional: LangFuse cloud free tier ───────────────────────────────────────
# Sign up free at https://cloud.langfuse.com (no credit card)
# LANGFUSE_PUBLIC_KEY = "pk-lf-..."
# LANGFUSE_SECRET_KEY = "sk-lf-..."
# LANGFUSE_HOST       = "https://cloud.langfuse.com"

# ── Optional: other providers ────────────────────────────────────────────────
# OPENAI_API_KEY    = "sk-..."
# ANTHROPIC_API_KEY = "sk-ant-..."
