# ── Copy this content into Streamlit Cloud → App Settings → Secrets ──────────
# Do NOT commit the real secrets.toml — it's in .gitignore

AI_PROVIDER = "groq"
GROQ_API_KEY = "gsk_your_key_here"
GROQ_MODEL   = "llama-3.3-70b-versatile"

# Gemini — used for Chat with Data tab only (Google Solution Challenge)
GEMINI_API_KEY = "AIza_your_gemini_key_here"

APP_PASSWORD = "your_strong_password_here"

# Optional — only needed if you switch providers
# OPENAI_API_KEY    = "sk-..."
# OPENAI_MODEL      = "gpt-4o-mini"
# ANTHROPIC_API_KEY = "sk-ant-..."
# ANTHROPIC_MODEL   = "claude-3-5-haiku-20241022"
